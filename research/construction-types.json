  "project_types": {
    "duplex": {
      "code": "CRC",
      "occupancy": "R-3",
      "note": "Detached two-family dwelling up to 3 stories above grade plane is within CRC scope (R101.2). The CRC sections read here (R101.2, R302, R309) do not depend on construction type. Over 3 stories it goes to the CBC as R-3 (310.4: not more than two dwelling units); use the R-3 allowable rows.",
      "source": {
        "title": "2025 California Residential Code (Title 24 Part 2.5), UpCodes",
        "url": "https://up.codes/viewer/california/ca-residential-code-2025/chapter/1/administration#R101.2",
        "section": "R101.2; CBC 310.4"
      },
      "status": "VERIFIED"
    },
    "triplex": {
      "code": "CBC",
      "occupancy": "R-2",
      "note": "3 units in one building = 'more than two dwelling units' -> R-2 (310.3); R-3 is limited to buildings with not more than two units (310.4). Exception path: if the 3 units are built as townhouses (not more than 3 stories, separate means of egress), CRC R101.2 scope covers them. The CRC townhouse definition itself was not read.",
      "source": {
        "title": "2025 California Building Code (Title 24 Part 2), UpCodes",
        "url": "https://up.codes/viewer/california/ca-building-code-2025/chapter/3/occupancy-classification-and-use#310.3",
        "section": "310.3, 310.4; CRC R101.2"
      },
      "status": "VERIFIED"
    }
  },
