  "requirements": [
    {
      "id": "crc_scope",
      "applies_to": [
        "duplex",
        "triplex"
      ],
      "construction_types": [
        "any"
      ],
      "rule": "The CRC covers detached one- and two-family dwellings and townhouses not more than three stories above grade plane, each with a separate means of egress. A duplex of 4+ stories, or any non-townhouse building with 3+ units, goes to the CBC.",
      "required_evidence_on_plans": "Cover sheet: governing code (CRC vs CBC), number of dwelling units, number of stories above grade plane; sections/elevations showing story count.",
      "source": {
        "title": "2025 California Residential Code (Title 24 Part 2.5), UpCodes",
        "url": "https://up.codes/viewer/california/ca-residential-code-2025/chapter/1/administration#R101.2",
        "section": "R101.2"
      },
      "status": "VERIFIED"
    },
    {
      "id": "cbc_occupancy_r2_r3",
      "applies_to": [
        "duplex",
        "triplex"
      ],
      "construction_types": [
        "any"
      ],
      "rule": "R-2 = buildings with more than two dwelling units (apartment houses etc.). R-3 = buildings with not more than two dwelling units. A 3-unit building under the CBC is R-2; a duplex under the CBC is R-3.",
      "required_evidence_on_plans": "Code analysis block: occupancy classification consistent with unit count.",
      "source": {
        "title": "2025 California Building Code (Title 24 Part 2), UpCodes",
        "url": "https://up.codes/viewer/california/ca-building-code-2025/chapter/3/occupancy-classification-and-use#310.3",
        "section": "310.3, 310.4"
      },
      "status": "VERIFIED"
    },
    {
      "id": "crc_two_family_separation",
      "applies_to": [
        "duplex"
      ],
      "construction_types": [
        "any"
      ],
      "rule": "The two units must be separated by vertical and/or horizontal fire-resistance-rated assemblies of 1 hour, or 1/2 hour when the building is sprinklered throughout per CRC R309 (NFPA 13D or R309.3). Applies whether or not a lot line runs between the units. Assemblies must be continuous: walls run to the foundation and to the underside of roof sheathing (or a rated ceiling/floor), floors run tight to exterior walls or the rated wall.",
      "required_evidence_on_plans": "Floor plans/sections tagging the unit separation wall and/or floor with a tested assembly (UL/GA number, ASTM E119/UL 263) and its rating; detail showing continuity to foundation and roof sheathing; sprinkler note if 1/2-hour is used.",
      "source": {
        "title": "2025 California Residential Code (Title 24 Part 2.5), UpCodes",
        "url": "https://up.codes/viewer/california/ca-residential-code-2025/chapter/3/building-planning#R302.3",
        "section": "R302.3, R302.3.1-R302.3.3"
      },
      "status": "VERIFIED"
    },
    {
      "id": "cbc_unit_separation_walls",
      "applies_to": [
        "triplex",
        "duplex"
      ],
      "construction_types": [
        "I-A",
        "I-B",
        "II-A",
        "III-A",
        "IV-HT",
        "V-A"
      ],
      "rule": "Walls between dwelling units are fire partitions (Section 708) with at least a 1-hour fire-resistance rating.",
      "required_evidence_on_plans": "Wall legend with a 1-hour rated assembly (listed design number) at every demising wall; fire partition continuity details (708.4).",
      "source": {
        "title": "2025 California Building Code (Title 24 Part 2), UpCodes",
        "url": "https://up.codes/viewer/california/ca-building-code-2025/chapter/7/fire-and-smoke-protection-features#708.3",
        "section": "420.2, 708.3"
      },
      "status": "VERIFIED"
    },
    {
      "id": "cbc_unit_separation_walls_half_hour",
      "applies_to": [
        "triplex",
        "duplex"
      ],
      "construction_types": [
        "II-B",
        "III-B",
        "V-B"
      ],
      "rule": "Dwelling unit separation walls may be 1/2 hour in Types IIB, IIIB and VB only when the building is sprinklered throughout with NFPA 13 (903.3.1.1). With NFPA 13R or 13D the 1-hour minimum stays.",
      "required_evidence_on_plans": "If 1/2-hour is shown: construction type IIB/IIIB/VB and NFPA 13 (903.3.1.1) sprinkler system stated on the cover sheet.",
      "source": {
        "title": "2025 California Building Code (Title 24 Part 2), UpCodes",
        "url": "https://up.codes/viewer/california/ca-building-code-2025/chapter/7/fire-and-smoke-protection-features#708.3",
        "section": "708.3 Exception 2"
      },
      "status": "VERIFIED"
    },
    {
      "id": "cbc_unit_separation_floors",
      "applies_to": [
        "triplex",
        "duplex"
      ],
      "construction_types": [
        "I-A",
        "I-B",
        "II-A",
        "II-B",
        "III-A",
        "III-B",
        "IV-HT",
        "V-A",
        "V-B"
      ],
      "rule": "Floors between dwelling units are horizontal assemblies (Section 711) of at least 1 hour. Exception: 1/2 hour in Types IIB, IIIB and VB when sprinklered throughout with NFPA 13 (903.3.1.1).",
      "required_evidence_on_plans": "Sections/floor-ceiling assembly detail with listed rating at floors between units; sprinkler type stated if 1/2-hour is used.",
      "source": {
        "title": "2025 California Building Code (Title 24 Part 2), UpCodes",
        "url": "https://up.codes/viewer/california/ca-building-code-2025/chapter/7/fire-and-smoke-protection-features#711.2.4.3",
        "section": "420.3, 711.2.4.3"
      },
      "status": "VERIFIED"
    },
    {
      "id": "cbc_group_r_sprinklers",
      "applies_to": [
        "triplex",
        "duplex"
      ],
      "construction_types": [
        "I-A",
        "I-B",
        "II-A",
        "II-B",
        "III-A",
        "III-B",
        "IV-HT",
        "V-A",
        "V-B"
      ],
      "rule": "Every building with a Group R fire area needs an automatic sprinkler system per 903.3 (NFPA 13, 13R or 13D as allowed). R-3 may use NFPA 13D (903.2.8.1, 903.3.1.3). The NS columns in Tables 504.3/504.4/506.2 are only for existing buildings (footnote d), so new R buildings use the sprinklered columns.",
      "required_evidence_on_plans": "Cover sheet: 'Fire sprinklers: NFPA 13 / 13R / 13D' (deferred submittal to fire authority); code analysis uses the matching table column.",
      "source": {
        "title": "2025 California Building Code (Title 24 Part 2), UpCodes",
        "url": "https://up.codes/viewer/california/ca-building-code-2025/chapter/9/fire-protection-and-life-safety-systems#903.2.8",
        "section": "420.4, 903.2.8, 903.2.8.1, 903.3.1.3"
      },
      "status": "VERIFIED"
    },
    {
      "id": "cbc_nfpa13r_limits",
      "applies_to": [
        "triplex"
      ],
